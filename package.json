{
    "name": "codecept-bdd-aljazeera",
    "version": "1.0.0",
    "private": true,
    "description": "CodeceptJS BDD Test Automation Framework for aljazeera.com",
    "scripts": {
        "test:bdd": "npx codeceptjs run --features --steps",
        "bdd:bypass": "npx codeceptjs run --grep @bypass --steps",
        "bdd:livestream": "npx codeceptjs run --grep @live --steps",
        "test:all": "npm run bdd:bypass && npm run bdd:livestream",
        "allure:clean": "rimraf allure-report allure-results || true && rimraf output/allure || true",
        "allure:generate": "allure generate --clean output/allure -o allure-report",
        "allure:open": "allure open allure-report"
    },
    "devDependencies": {
        "@codeceptjs/allure-legacy": "^1.0.2",
        "@codeceptjs/configure": "^1.0.6",
        "@codeceptjs/examples": "^1.2.4",
        "@codeceptjs/ui": "^1.3.8",
        "@types/node": "^22.19.1",
        "allure-commandline": "^2.34.1",
        "assert": "^2.1.0",
        "chromedriver": "^141.0.3",
        "codeceptjs": "^3.7.5",
        "cross-env": "^10.1.0",
        "dotenv": "^16.6.1",
        "playwright": "^1.56.1",
        "rimraf": "^6.0.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "webdriverio": "^9.20.0"
    }
}
